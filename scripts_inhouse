def read_roc(path):
    meta = {}
    with open(path) as f:
        first = f.readline().strip()
    if first.startswith("#"):
        for item in first.lstrip("#").split(","):
            if "=" in item:
                k, v = item.split("=", 1)
                meta[k.strip()] = float(v.strip())
    df = pd.read_csv(path, comment="#")
    fpr = df["fpr"].values
    tpr = df["tpr"].values
    idx = np.argsort(fpr)
    return fpr[idx], tpr[idx], meta


